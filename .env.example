# Polymarket API Configuration
# Your Polygon wallet private key (required for trading)
POLYGON_WALLET_PRIVATE_KEY=

# Optional: Funder address for proxy wallets
FUNDER_ADDRESS=

# API Endpoints (defaults shown)
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# Anthropic API (required for LLM strategy)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Trading Configuration
# Options: paper, live, backtest
TRADING_MODE=paper

# Risk Management Settings
MAX_POSITION_SIZE_USD=100.0
MAX_TOTAL_EXPOSURE_USD=500.0
MAX_POSITION_PER_MARKET_PCT=0.20
DAILY_LOSS_LIMIT_USD=50.0
STOP_LOSS_PCT=0.15

# Strategy Parameters
MOMENTUM_LOOKBACK_PERIODS=24
MOMENTUM_THRESHOLD=0.05
LLM_CONFIDENCE_THRESHOLD=0.7

# Execution
DEFAULT_ORDER_TYPE=GTC
MIN_ORDER_SIZE_USD=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
